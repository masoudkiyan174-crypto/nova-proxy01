{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy01",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b24046d7-f61f-48dc-affe-557856708e51","database_name": "nova-proxy01" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d93fa1a9bb634059a516d39eabb5f920" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
